# WTQ Utility Bill Decoder - Environment Configuration
# Copy this file to .env and fill in your actual values

# Model Provider
MODEL_PROVIDER=google

# Model Name (must be one of the allowed competition models)
MODEL_NAME=gemini-3.5-flash-lite

# API Key (get from Google AI Studio)
API_KEY=your-api-key-here

# Optional: Paths
DATA_DIR=../data
OUTPUT_DIR=../output